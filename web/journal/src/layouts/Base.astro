---
import { SITE } from '../lib/site';

interface Props {
  title: string;
  description: string;
  url?: string;
  image?: string | null;
  type?: 'website' | 'article';
  publishedTime?: string | null;
  tags?: string[];
  jsonLd?: unknown;
}

const {
  title,
  description,
  url,
  image,
  type = 'website',
  publishedTime,
  tags = [],
  jsonLd,
} = Astro.props;

const canonical = url ?? new URL(Astro.url.pathname, SITE.url).href;
const ogImage = image || undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%8D%B7%3C/text%3E%3C/svg%3E"
    />

    <!-- Native iOS Safari install banner -->
    <meta name="apple-itunes-app" content={`app-id=${SITE.appleAppId}`} />

    <!-- Open Graph -->
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === 'article' && tags.map((t) => <meta property="article:tag" content={t} />)}

    <!-- Twitter / X -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Spectral:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">
        <span class="brand-mark">Vinster</span>
        <span class="brand-sub">The Journal</span>
      </a>
      <a class="header-cta" href={SITE.appStoreUrl}>Get Vinster</a>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p class="foot-tagline">{SITE.appTagline}</p>
      <div class="foot-links">
        <a href={SITE.appStoreUrl}>App Store</a>
        <span aria-hidden="true">·</span>
        <a href={SITE.playStoreUrl}>Google Play</a>
        <span aria-hidden="true">·</span>
        <a href="/rss.xml">RSS</a>
      </div>
      <p class="foot-copy">© {new Date().getFullYear()} Vinster</p>
    </footer>

    <style is:global>
      :root {
        --bg: #7f4f4c;
        --surface: #572f2b;
        --surface-2: #4a2522;
        --gold: #e0b84a;
        --gold-dim: #9a7f40;
        --cream: #f4ebe0;
        --cream-dim: #e2d6c6;
        --text: #ffffff;
        --muted: rgba(255, 255, 255, 0.72);
        --faint: rgba(255, 255, 255, 0.55);
        --border: rgba(255, 255, 255, 0.12);
        --border-strong: rgba(255, 255, 255, 0.2);
        --display: 'Cormorant Garamond', Georgia, serif;
        --body: 'Spectral', Georgia, serif;
      }

      * { box-sizing: border-box; }

      html { -webkit-text-size-adjust: 100%; }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: var(--body);
        font-size: 18px;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      a { color: inherit; }

      main { flex: 1 0 auto; }

      img { max-width: 100%; height: auto; display: block; }

      /* ---- Header ---- */
      .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.1rem clamp(1.25rem, 5vw, 3rem);
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        background: color-mix(in srgb, var(--bg) 92%, black);
        backdrop-filter: blur(8px);
        z-index: 10;
      }
      .brand { text-decoration: none; display: flex; flex-direction: column; line-height: 1.05; }
      .brand-mark {
        font-family: var(--display);
        font-weight: 700;
        font-size: 1.5rem;
        letter-spacing: 0.06em;
      }
      .brand-sub {
        font-family: var(--display);
        font-weight: 400;
        font-style: italic;
        font-size: 0.9rem;
        color: var(--gold);
      }
      .header-cta {
        text-decoration: none;
        font-family: var(--display);
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--gold);
        border: 1px solid var(--gold);
        border-radius: 999px;
        padding: 0.4rem 1rem;
        white-space: nowrap;
        transition: background 0.15s ease;
      }
      .header-cta:hover { background: rgba(224, 184, 74, 0.14); }

      /* ---- Shared layout ---- */
      .wrap { max-width: 44rem; margin: 0 auto; padding: 0 clamp(1.25rem, 5vw, 2rem); }

      /* ---- Article typography ---- */
      .prose { font-size: 1.1rem; }
      .prose p { margin: 0 0 1.25rem; }
      .prose h2 {
        font-family: var(--display);
        font-weight: 600;
        font-size: 1.9rem;
        line-height: 1.2;
        margin: 2.2rem 0 0.75rem;
        letter-spacing: 0.01em;
      }
      .prose h3 {
        font-family: var(--display);
        font-weight: 600;
        font-size: 1.4rem;
        color: var(--gold);
        margin: 1.8rem 0 0.5rem;
      }
      .prose ul { margin: 0 0 1.25rem; padding-left: 1.2rem; }
      .prose li { margin-bottom: 0.4rem; }
      .prose li::marker { color: var(--gold); }
      .prose blockquote {
        margin: 1.5rem 0;
        padding: 0.2rem 0 0.2rem 1.1rem;
        border-left: 2px solid var(--gold);
        color: var(--gold);
        font-style: italic;
      }
      .prose strong { font-weight: 700; }
      .prose a { color: var(--gold); text-underline-offset: 3px; }

      /* ---- Footer ---- */
      .site-footer {
        flex-shrink: 0;
        border-top: 1px solid var(--border);
        margin-top: 4rem;
        padding: 2.5rem clamp(1.25rem, 5vw, 3rem);
        text-align: center;
        color: var(--muted);
      }
      .foot-tagline { font-family: var(--display); font-style: italic; font-size: 1.15rem; margin: 0 0 0.75rem; }
      .foot-links { display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap; font-size: 0.95rem; }
      .foot-links a { color: var(--gold); text-decoration: none; }
      .foot-links a:hover { text-decoration: underline; }
      .foot-copy { font-size: 0.85rem; color: var(--faint); margin: 1rem 0 0; }
    </style>
  </body>
</html>
