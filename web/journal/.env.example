# Copy to .env for local builds, and set the same two values in your static
# host's environment (Cloudflare Pages / Netlify / Vercel).
# Both are safe to expose — the anon/publishable key is already shipped in the
# mobile app, and RLS limits the build to reading published posts only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-publishable-key
